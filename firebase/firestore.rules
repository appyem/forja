rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar si el usuario es admin
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Función auxiliar para verificar si el usuario es el dueño del recurso
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ==========================================
    // 1. PRODUCTOS Y CATEGORÍAS (Lectura pública, escritura solo admin)
    // ==========================================
    match /products/{productId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    // ==========================================
    // 2. PEDIDOS (Solo el dueño o un admin puede verlos/modificarlos)
    // ==========================================
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 3. USUARIOS (Solo el dueño puede leer su perfil, admin puede gestionar)
    // ==========================================
    match /users/{userId} {
            allow create: if isOwner(userId)
        && request.resource.data.role == "client"
        && request.resource.data.keys().hasOnly(["id", "email", "displayName", "role", "phone", "createdAt"]);
      allow update, delete: if isAdmin();

    // ==========================================
    // 4. CONFIGURACIÓN DE LA TIENDA (Lectura pública, escritura solo admin)
    // ==========================================
    match /storeSettings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    // ==========================================
    // 5. DENEGAR TODO LO DEMÁS POR DEFECTO
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}